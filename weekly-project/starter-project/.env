# MongoDB Connection String (Database URL)
MONGO_URI=
# Secret key used to sign JWT tokens
JWT_SECRET=
# Token expiration duration (e.g., 1h, 30m, 7d)
JWT_EXPIRES_IN=1h
#  Backend server port number
PORT=5000
# Stripe Secret Key for payment processing
STRIPE_SECRET_KEY=
# Email address used to send emails (e.g., Gmail or SMTP)
EMAIL_USER=
# Email App Password
EMAIL_PASS=